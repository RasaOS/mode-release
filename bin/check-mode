#!/usr/bin/env python3
"""
bin/check-mode — the release gate for a RasaOS mode module (`mode-<id>`).

  bin/check-mode                                        check this repo; exit 1 on any problem
  RASA_SCHEMA_DIR=~/rAI/rasa-os/schema bin/check-mode    also run the canonical rasa.json validator

Checks, each printed ok / FAIL:

  1. rasa.json is the mode's: kind module, name rasa.module.mode.<id>, source
     RasaOS/mode-<id>, and rasa.mode_id / rasa.mode_version equal mode.json's.
  2. One version everywhere: VERSION, rasa.json, plugin.json, the top
     CHANGELOG.md heading and README.md's **Version:** line.
  3. .claude-plugin/plugin.json names rasa-mode-<id> and declares no hooks
     and no MCP servers.
  4. A mode is a pure composition declaration (galt ADR 0071): no
     prompt.md, settings.json, .mcp.json, hooks/ or role.json. Everything
     it contributes comes from the member Elements mode.json names.
  5. mode.json keeps galt's ModeManifestSchema limits (bus-contract
     src/modes.ts), copied here by hand: id matches mode-<id>, version is
     a non-empty string, elements is 1..8 entries, each exactly
     {element, ref}, no element named twice.
  6. No canon ELEMENT_CONTRACT §8 forbidden vocabulary.
  7. No secret-shaped strings (GitHub, OpenAI, Google, Slack and AWS tokens,
     private keys). The repo is public. This catches only the obvious
     shapes; it does not prove the repo is clean.
  8. The canonical validator (RasaOS/schema bin/validate) passes on
     rasa.json. It is SKIPPED unless RASA_SCHEMA_DIR is set, and a skip is
     not a pass.

Standard library only.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

MODE_ID_RE = re.compile(r"^mode-[a-z][a-z0-9._-]{0,74}$")
ELEMENT_NAME_RE = re.compile(r"^[a-z][a-z0-9._-]{0,79}$")
ELEMENT_REF_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$")
SEMVER_RE = re.compile(r"^\d+\.\d+\.\d+$")
MODE_KEYS = {"id", "version", "elements"}
ELEMENT_KEYS = {"element", "ref"}
MAX_ELEMENTS = 8
FORBIDDEN = ["MANIFEST.json", "foundation.json", "manifest contract", "bootstrap/"]
SECRET_RES = [re.compile(x) for x in (
    r"gh[pousr]_[A-Za-z0-9]{30,}", r"github_pat_[A-Za-z0-9_]{30,}", r"sk-[A-Za-z0-9_-]{20,}",
    r"AIza[0-9A-Za-z_-]{30,}", r"xox[abposr]-[A-Za-z0-9-]{10,}", r"AKIA[0-9A-Z]{16}",
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----")]

failed = 0


def report(n, title, problems):
    global failed
    if problems:
        failed += 1
        print(f"  {n}. FAIL {title}")
        for p in problems:
            print(f"       - {p}")
    else:
        print(f"  {n}. ok   {title}")


def load_json(rel):
    path = ROOT / rel
    if not path.is_file():
        return None, f"{rel} is missing"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except ValueError as e:
        return None, f"{rel} is not valid JSON ({e})"
    if not isinstance(value, dict):
        return None, f"{rel} must be a JSON object"
    return value, None


rasa, rasa_err = load_json("rasa.json")
mode, mode_err = load_json("mode.json")
plugin, plugin_err = load_json(".claude-plugin/plugin.json")
mid = mode.get("id") if mode else None
if not isinstance(mid, str) or not MODE_ID_RE.match(mid):
    print(f"check-mode: mode.json has no usable id ({mode_err or mid!r}); nothing else can be checked")
    sys.exit(1)

print(f"check-mode: {mid}")

# 1 — rasa.json is the mode's
p = [rasa_err] if rasa_err else []
if rasa:
    if rasa.get("kind") != "module":
        p.append(f"kind is {rasa.get('kind')!r}; a mode is a module (canon's recipe kind, once it lands)")
    if rasa.get("name") != f"rasa.module.mode.{mid[len('mode-'):]}":
        p.append(f"name is {rasa.get('name')!r}; expected rasa.module.mode.{mid[len('mode-'):]}")
    if (rasa.get("source") or {}).get("repo") != f"https://github.com/RasaOS/{mid}":
        p.append(f"source.repo is not https://github.com/RasaOS/{mid}")
    meta = rasa.get("rasa") or {}
    if meta.get("mode_id") != mid:
        p.append(f"rasa.mode_id is {meta.get('mode_id')!r}; mode.json id is {mid!r}")
    if meta.get("mode_version") != mode.get("version"):
        p.append(f"rasa.mode_version is {meta.get('mode_version')!r}; mode.json version is {mode.get('version')!r}")
report(1, "rasa.json is this mode's", p)

# 2 — one version everywhere
p = []
version_file = (ROOT / "VERSION").read_text(encoding="utf-8").strip() if (ROOT / "VERSION").is_file() else None
versions = {"VERSION": version_file,
            "rasa.json": rasa.get("version") if rasa else None,
            "plugin.json": plugin.get("version") if plugin else None,
            "mode.json": mode.get("version")}
cl = ROOT / "CHANGELOG.md"
m = re.search(r"^## (\d+\.\d+\.\d+)\b", cl.read_text(encoding="utf-8"), re.M) if cl.is_file() else None
versions["CHANGELOG.md"] = m.group(1) if m else None
rd = ROOT / "README.md"
m = re.search(r"\*\*Version:\*\*\s*(\d+\.\d+\.\d+)", rd.read_text(encoding="utf-8")) if rd.is_file() else None
versions["README.md"] = m.group(1) if m else None
if not version_file or not SEMVER_RE.match(version_file):
    p.append(f"VERSION is {version_file!r}; expected MAJOR.MINOR.PATCH")
for where, v in versions.items():
    if v != version_file:
        p.append(f"{where} says {v!r}; VERSION says {version_file!r}")
report(2, f"one version ({version_file})", p)

# 3 — the plugin manifest
p = [plugin_err] if plugin_err else []
if plugin:
    if plugin.get("name") != f"rasa-{mid}":
        p.append(f"plugin.json name is {plugin.get('name')!r}; expected rasa-{mid}")
    for key in ("hooks", "mcpServers"):
        if plugin.get(key):
            p.append(f"plugin.json declares {key}: a mode widens nothing")
report(3, ".claude-plugin/plugin.json", p)

# 4 — a mode is a pure composition declaration
p = []
for rel in ("prompt.md", "settings.json", ".mcp.json", "hooks", "role.json"):
    if (ROOT / rel).exists():
        p.append(f"{rel} exists: a mode carries no behaviour of its own (galt ADR 0071) — only its members do")
if rasa and rasa.get("permissions"):
    p.append("rasa.json permissions is not []: a mode widens nothing")
report(4, "a pure composition declaration (no prompt/settings/skills of its own)", p)

# 5 — mode.json
p = []
for k in mode:
    if k not in MODE_KEYS:
        p.append(f"unknown key {k!r}")
if not isinstance(mode.get("version"), str) or len(mode["version"]) < 1:
    p.append("version must be a non-empty string")
elements = mode.get("elements")
if not isinstance(elements, list) or not 1 <= len(elements) <= MAX_ELEMENTS:
    p.append(f"elements must be a list of 1..{MAX_ELEMENTS}")
    elements = []
seen = set()
for i, e in enumerate(elements):
    if not isinstance(e, dict) or set(e) != ELEMENT_KEYS:
        p.append(f"elements[{i}] must be exactly {{element, ref}}")
        continue
    name = e.get("element")
    ref = e.get("ref")
    if not isinstance(name, str) or not ELEMENT_NAME_RE.match(name):
        p.append(f"elements[{i}].element {name!r} is not a usable Element name")
    elif name in seen:
        p.append(f"elements[{i}].element {name!r} is listed twice")
    seen.add(name)
    if not isinstance(ref, str) or not ELEMENT_REF_RE.match(ref):
        p.append(f"elements[{i}].ref {ref!r} is not a usable ref")
report(5, f"mode.json ({mid} v{mode.get('version')}, {len(elements)} member(s))", p)

# 6 — canon §8 vocabulary, and 7 — secret-shaped strings
p = []
secrets = []
try:
    files = subprocess.run(["git", "ls-files"], cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
except (OSError, subprocess.CalledProcessError):
    files = [str(f.relative_to(ROOT)) for f in ROOT.rglob("*") if f.is_file() and ".git" not in f.parts]
for rel in files:
    if rel == "bin/check-mode":
        continue
    try:
        text = (ROOT / rel).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        continue
    for term in FORBIDDEN:
        if term in text:
            p.append(f"{rel} uses {term!r}")
    for rx in SECRET_RES:
        if rx.search(text):
            secrets.append(f"{rel} holds something shaped like a secret ({rx.pattern[:12]}…): remove it and rotate it")
report(6, "canon §8 vocabulary", p)
report(7, "no secret-shaped strings (public repo)", secrets)

# 8 — the canonical validator
schema = os.environ.get("RASA_SCHEMA_DIR")
if not schema:
    print("  8. SKIP canonical validator (set RASA_SCHEMA_DIR to a RasaOS/schema checkout; a skip is not a pass)")
else:
    sdir = Path(schema).expanduser()
    py = sdir / ".venv" / "bin" / "python3"
    cmd = [str(py) if py.exists() else sys.executable, str(sdir / "bin" / "validate"), str(ROOT / "rasa.json")]
    r = subprocess.run(cmd, capture_output=True, text=True)
    report(8, "canonical validator PASS" if r.returncode == 0 else "canonical validator",
           [] if r.returncode == 0 else [ln for ln in (r.stdout + r.stderr).strip().splitlines()[-6:]])

print("check-mode: " + ("GREEN" if failed == 0 else f"{failed} check(s) failed"))
sys.exit(1 if failed else 0)
